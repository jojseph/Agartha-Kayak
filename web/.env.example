# ─── Public (exposed to browser) ───────────────────

pag buhat og (.env.local) haha!
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
BLOCKFROST_PROJECT_ID=your_blockfrost_preprod_id_here

# ─── Cardano on-chain witness (Module 3 worker) ───
# BLOCKFROST_PROJECT_ID above is reused by the worker (must be PREPROD).
# Submitter wallet that pays tx fees and signs the metadata tx. MUST be a
# preprod wallet funded with test ADA from the Cardano faucet.
CARDANO_SUBMITTER_SKEY=your_preprod_signing_key_hex_or_cbor_here
CARDANO_SUBMITTER_ADDRESS=addr_test1...your_preprod_submitter_address
# Shared secret the local worker script sends in the Authorization header.
# Run the script as: WORKER_TRIGGER_SECRET=<this value> node scripts/local-etch-worker.js
WORKER_TRIGGER_SECRET=generate_a_long_random_string_here

# ─── Server-only secrets ──────────────────────────
# DATABASE_URL=
# AUTH_SECRET=
